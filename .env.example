# Скопируй в .env и заполни реальными значениями. Секреты не коммитить.

# --- Backend (FastAPI) ---
ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://goalup:goalup@localhost:5432/goalup

# Auth (для Этапа 2)
# SECRET_KEY=change-me
# AUTH_COOKIE_NAME=goalup_session
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=localhost
# ACCESS_TOKEN_EXPIRE_HOURS=168

# CORS (для локальной разработки)
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# --- PostgreSQL (для docker-compose) ---
POSTGRES_USER=goalup
POSTGRES_PASSWORD=goalup
POSTGRES_DB=goalup
POSTGRES_PORT=5432